# restaurant-loyalty environment (Expo inlines EXPO_PUBLIC_* at build time).
# Copy to .env and fill in. Each client gets their own app build branded by the
# restaurant slug below. Firebase is the shared PLATFORM project (menudock-platform).

# Which restaurant this app build is for (its `slug` in the restaurants collection).
EXPO_PUBLIC_RESTAURANT_SLUG=taco-monster

# Platform Firebase project (shared across all restaurants).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
